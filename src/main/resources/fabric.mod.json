{
  "schemaVersion": 1,
  "id": "unusual_furniture",
  "name": "Unusual Furniture",
  "version": "${version}",
  "authors": ["to0pa", "macuguita"],
  "contact": {
    "sources": "https://github.com/To0pa/Unusual-Furniture",
    "issues": "https://github.com/To0pa/Unusual-Furniture/issues"
  },
  "description": "Vanilla styled furniture mod!",
  "icon": "assets/unusual_furniture/logo.png",
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.toopa.unusual_furniture.fabric.FabricEntrypoint"
    ],
    "client": [
      "net.toopa.unusual_furniture.fabric.FabricClientEntrypoint"
    ],
    "fabric-datagen": [
      "net.toopa.unusual_furniture.fabric.datagen.UnusualFurnitureDatagen"
    ]
  },
  "mixins": [
    "unusual_furniture.mixins.json"
  ],
  "depends": {
    "fabric-api": "*",
    "minecraft": "${minecraft}"
  }
}
